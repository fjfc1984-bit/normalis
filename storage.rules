rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Evidencias fotográficas de auditoría
    // Usuarios autenticados solo pueden leer/escribir bajo su propio UID
    match /evidencias/{uid}/{ansKey}/{fileName} {
      allow read:  if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size <= 5 * 1024 * 1024       // max 5MB
                   && request.resource.contentType.matches('image/.*'); // solo imágenes
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Documentos institucionales (PDFs generados)
    match /documentos/{uid}/{fileName} {
      allow read:  if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size <= 20 * 1024 * 1024      // max 20MB
                   && (request.resource.contentType.matches('application/pdf')
                    || request.resource.contentType.matches('image/.*'));
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Denegar todo lo demás
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
