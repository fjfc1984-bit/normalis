// NormaLis — Firestore Security Rules
// Proyecto: normalis-5587d
// Aplicar via CLI: firebase deploy --only firestore:rules --project normalis-5587d
//
// Colecciones:
//   usuarios/{uid}           — perfiles de usuario (rol, activo, expiresAt, rol_ips, nit_ips)
//   ips/{nit}/data/{key}     — datos de auditoría por IPS (normalis-firestore.js)
//   pilotos/{nit}            — seguimiento programa piloto
//   prospectos/{id}          — CRM (solo admin)
//   leads/{id}               — solicitudes demo desde index.html (escritura pública)
//   capas/{id}               — módulo CAPA / Plan de Mejoramiento PAMEC
//   vencimientos/{id}        — módulo de vencimientos personal
//   indicadores/{id}         — módulo indicadores Res. 256/2016
//   invitaciones/{code}      — sistema de invitaciones de equipo IPS

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ────────────────────────────────────────────────────────────────────────
    // Helpers
    // ────────────────────────────────────────────────────────────────────────

    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isActiveClient() {
      let userData = get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
      return request.auth != null &&
        (userData.rol == 'cliente' || userData.rol == 'piloto') &&
        userData.activo == true;
    }

    // Usuario activo (cliente, piloto o admin)
    function isAuthenticated() {
      return request.auth != null;
    }

    // El usuario pertenece al mismo NIT que el documento (para consultas de equipo)
    function sameNIT(nitField) {
      let myData = get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
      return request.auth != null && myData.nit == nitField;
    }

    // El usuario es director de la IPS (nit en su propio doc = nit del recurso)
    function isDirectorOf(nit) {
      let myData = get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
      return request.auth != null &&
        myData.nit == nit &&
        (myData.rol == 'cliente' || myData.rol == 'piloto' || myData.rol == 'admin');
    }

    // ════════════════════════════════════════════════════════════════════════
    // usuarios/{uid} — perfiles de usuario
    // ════════════════════════════════════════════════════════════════════════
    match /usuarios/{uid} {
      // Leer propio perfil; admin puede leer todos;
      // usuarios del mismo NIT pueden leerse entre sí (vista de equipo)
      allow read: if isOwner(uid) || isAdmin() ||
        (isAuthenticated() &&
         get(/databases/$(database)/documents/usuarios/$(uid)).data.nit ==
         get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.nit) ||
        (isAuthenticated() &&
         get(/databases/$(database)/documents/usuarios/$(uid)).data.nit_ips ==
         get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.nit);

      // Crear: solo registro.html — usuario autenticado crea su propio doc
      // Permite nit_ips y rol_ips para usuarios que se registran por invitación
      allow create: if isOwner(uid) &&
        request.resource.data.rol == 'pendiente' &&
        request.resource.data.activo == false;

      // Actualizar propio perfil; admin puede actualizar cualquiera;
      // director puede actualizar rol_ips de miembros de su IPS
      allow update: if isOwner(uid) || isAdmin() ||
        (isAuthenticated() &&
         get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.nit ==
         get(/databases/$(database)/documents/usuarios/$(uid)).data.nit_ips);

      // Eliminar: solo admin
      allow delete: if isAdmin();
    }

    // ════════════════════════════════════════════════════════════════════════
    // ips/{nit}/data/{key} — datos de auditoría por IPS
    // ════════════════════════════════════════════════════════════════════════
    match /ips/{nit} {
      allow read: if isAdmin();
      allow write: if isAdmin();

      match /data/{key} {
        // Acceso compartido por IPS: el usuario debe pertenecer al NIT
        // o ser admin. Soporta tres casos:
        //   1. Legacy: uid == nit (usuarios anteriores al multi-usuario)
        //   2. Miembro principal: su campo 'nit' en usuarios == nit del documento
        //   3. Miembro invitado: su campo 'nit_ips' en usuarios == nit del documento
        allow read, write: if isAuthenticated() &&
          (request.auth.uid == nit ||
           get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.nit == nit ||
           get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.nit_ips == nit ||
           isAdmin());
      }
    }

    // ════════════════════════════════════════════════════════════════════════
    // capas/{id} — módulo CAPA / Plan de Mejoramiento PAMEC
    // ════════════════════════════════════════════════════════════════════════
    match /capas/{id} {
      // Leer/escribir si eres el dueño (uid) o admin
      allow read: if isAuthenticated() &&
        (resource.data.uid == request.auth.uid || isAdmin());

      allow create: if isAuthenticated() &&
        request.resource.data.uid == request.auth.uid;

      allow update, delete: if isAuthenticated() &&
        (resource.data.uid == request.auth.uid || isAdmin());
    }

    // ════════════════════════════════════════════════════════════════════════
    // vencimientos/{id} — módulo de vencimientos personal
    // ════════════════════════════════════════════════════════════════════════
    match /vencimientos/{id} {
      allow read: if isAuthenticated() &&
        (resource.data.uid == request.auth.uid || isAdmin());

      allow create: if isAuthenticated() &&
        request.resource.data.uid == request.auth.uid;

      allow update, delete: if isAuthenticated() &&
        (resource.data.uid == request.auth.uid || isAdmin());
    }

    // ════════════════════════════════════════════════════════════════════════
    // indicadores/{id} — módulo indicadores Res. 256/2016
    // ════════════════════════════════════════════════════════════════════════
    match /indicadores/{id} {
      allow read: if isAuthenticated() &&
        (resource.data.uid == request.auth.uid || isAdmin());

      allow create: if isAuthenticated() &&
        request.resource.data.uid == request.auth.uid;

      allow update, delete: if isAuthenticated() &&
        (resource.data.uid == request.auth.uid || isAdmin());
    }

    // ════════════════════════════════════════════════════════════════════════
    // invitaciones/{code} — sistema de invitaciones de equipo IPS
    // ════════════════════════════════════════════════════════════════════════
    match /invitaciones/{code} {
      // Cualquier usuario autenticado puede leer una invitación por su código
      // (necesario durante el flujo de registro con ?invite=CODE)
      allow read: if isAuthenticated();

      // Solo clientes/pilotos/admin (directores) pueden crear invitaciones
      allow create: if isAuthenticated() &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol in
          ['cliente', 'piloto', 'admin'] &&
        request.resource.data.creadoPor == request.auth.uid;

      // Actualizar para marcar como usado (registro) o revocar (director)
      // Solo puede actualizar el creador, el invitado, o admin
      allow update: if isAuthenticated() &&
        (resource.data.creadoPor == request.auth.uid || isAdmin() ||
         resource.data.email == get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.email);

      // Solo admin o creador puede eliminar
      allow delete: if isAuthenticated() &&
        (resource.data.creadoPor == request.auth.uid || isAdmin());
    }

    // ════════════════════════════════════════════════════════════════════════
    // pilotos/{nit} — seguimiento del programa piloto
    // ════════════════════════════════════════════════════════════════════════
    match /pilotos/{nit} {
      allow read: if isAuthenticated() &&
        (request.auth.uid == nit || isAdmin());
      allow write: if isAdmin();
    }

    // ════════════════════════════════════════════════════════════════════════
    // prospectos/{id} — CRM interno (solo admin)
    // ════════════════════════════════════════════════════════════════════════
    match /prospectos/{id} {
      allow read, write: if isAdmin();
    }

    // ════════════════════════════════════════════════════════════════════════
    // leads/{id} — formulario demo público desde index.html
    // ════════════════════════════════════════════════════════════════════════
    match /leads/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ════════════════════════════════════════════════════════════════════════
    // normalis_orgs/{orgId} — sincronización secundaria (normalis-main.js)
    // orgId = 'nit_' + nit.replace(/[^a-zA-Z0-9]/g,'_')
    // ════════════════════════════════════════════════════════════════════════
    match /normalis_orgs/{orgId} {
      // Cualquier usuario autenticado puede leer/escribir (Firebase Auth ya garantiza
      // que el usuario pasó por login.html con rol válido; el orgId está ofuscado)
      allow read, write: if isAuthenticated();
    }

    // ════════════════════════════════════════════════════════════════════════
    // Denegar todo lo demás
    // ════════════════════════════════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }

  }
}
