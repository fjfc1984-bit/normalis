// NormaLis — Firestore Security Rules
// Proyecto: normalis-5587d
// Aplicar via CLI: firebase deploy --only firestore:rules --project normalis-5587d
//
// Colecciones raíz:
//   usuarios/{uid}              — perfiles de usuario (rol, activo, expiresAt, nit, nit_ips)
//   ips/{nit}/data/{key}        — datos de auditoría legacy por IPS
//   pilotos/{nit}               — seguimiento programa piloto
//   prospectos/{id}             — CRM (solo admin)
//   leads/{id}                  — solicitudes demo desde index.html (escritura pública)
//   capas/{id}                  — módulo CAPA / Plan de Mejoramiento PAMEC
//   vencimientos/{id}           — módulo de vencimientos personal
//   indicadores/{id}            — módulo indicadores Res. 256/2016
//   invitaciones/{code}         — sistema de invitaciones de equipo IPS
//   normalis_orgs/{orgId}       — sincronización secundaria por NIT
//   bitacora_seguridad/{id}     — bitácora de seguridad inmutable (solo el Worker escribe)
//   firmas/{id}                 — pruebas de firma electrónica inmutables (solo el Worker escribe)
//   documentos_dms/{id}         — Gestor Documental: versionado + flujo de aprobación
//   documentos_dms/{id}/socializaciones/{uid} — acuses individuales de socialización
//   equipos_biomedicos/{id}     — CMMS: inventario de equipos (Estándar de Dotación)
//   equipos_biomedicos/{id}/mantenimientos/{id} — hoja de vida (mantenimientos preventivos/correctivos)
//   infraestructura_areas/{id} — Gestión de Infraestructura Física (Estándar de Infraestructura)
//   infraestructura_areas/{id}/inspecciones/{id} — hoja de vida (inspecciones periódicas)
//   medicamentos_lotes/{id}     — Gestión de Medicamentos y Dispositivos: inventario de lotes
//   medicamentos_verificaciones/{id} — verificaciones periódicas del Servicio Farmacéutico
//   historia_clinica_auditorias/{id} — Auditoría de Historia Clínica por muestreo
//   historia_clinica_ihce/{id}  — estado declarado de integración a la red nacional IHCE (id = nit||uid, 1 doc por IPS)
//   interdependencia_convenios/{id} — red de prestadores: convenios y vigencias (Estándar de Interdependencia)
//   interdependencia_verificaciones/{id} — verificaciones periódicas del Estándar de Interdependencia
//   eventos_vigilancia/{id}     — Vigilancia Sanitaria: farmaco/tecno/reactivovigilancia (Numeral 6)
//   iaas_casos/{id}              — Vigilancia IAAS: casos individuales (SIVIGILA 357/352)
//   iaas_denominadores/{id}      — Vigilancia IAAS: consolidados mensuales (SIVIGILA 359/362)
//   informes_auditoria/{id}      — Informes formales de auditoría/eventualidad (intro, justificación, hallazgos, etc.)
//
// Subcollections de usuarios/{uid} (módulos Next.js):
//   usuarios/{uid}/pqrs/{id}        — PQRS (Peticiones, Quejas, Reclamos…)
//   usuarios/{uid}/incidentes/{id}  — Incidentes y Eventos Adversos
//   usuarios/{uid}/bitacora/{id}    — Bitácora de Gobernanza
//   usuarios/{uid}/sst/{docId}      — SG-SST (único doc: 'main')

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ────────────────────────────────────────────────────────────────────────
    // Helpers
    // ────────────────────────────────────────────────────────────────────────

    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }

    // Identidad exclusiva del Cloudflare Worker (cuenta cron@normalis.co,
    // ver cloudflare-worker/worker.js > getFirestoreToken). El Worker se
    // autentica como un usuario Firebase normal (no bypassa estas reglas),
    // así que su rol admin por sí solo NO basta para distinguirlo de un
    // admin humano real: cualquier cuenta con rol 'admin' satisface
    // isAdmin() por igual, incluida una comprometida. `firmas` y
    // `bitacora_seguridad` son las dos colecciones que el propio código
    // (lib/firmar.ts, worker.js) documenta como "inmutables — nadie puede
    // fabricar un registro sin el secreto del servidor"; esa garantía solo
    // es real si ÚNICAMENTE la cuenta cron puede crear ahí, nunca un admin
    // humano por el SDK de cliente. requiere `esCronWorker: true` en el
    // documento usuarios/{uid} de esa cuenta — ver nota de despliegue al
    // final de este archivo.
    function isCronWorker() {
      return request.auth != null &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.esCronWorker == true;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    // Usuarios del mismo NIT (para módulos con acceso compartido por IPS)
    function sameNIT(nitField) {
      let myData = get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
      return request.auth != null &&
        (myData.nit == nitField || myData.nit_ips == nitField);
    }

    // El campo `plan` (plan de suscripción: 'basico'|'profesional'|'enterprise')
    // es EXCLUSIVAMENTE asignado por un admin desde el panel — ni el propio
    // dueño de la cuenta ni un director de equipo (que sí puede editar otros
    // campos de sus compañeros) puede tocarlo por ninguna vía.
    function planSinCambios() {
      return !('plan' in request.resource.data.diff(resource.data).affectedKeys());
    }

    // ════════════════════════════════════════════════════════════════════════
    // usuarios/{uid} — perfiles de usuario + subcollections de módulos Next.js
    // ════════════════════════════════════════════════════════════════════════
    match /usuarios/{uid} {
      // Leer propio perfil; admin puede leer todos;
      // usuarios del mismo NIT pueden leerse entre sí (vista de equipo)
      allow read: if isOwner(uid) || isAdmin() ||
        (isAuthenticated() &&
         get(/databases/$(database)/documents/usuarios/$(uid)).data.nit ==
         get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.nit) ||
        (isAuthenticated() &&
         get(/databases/$(database)/documents/usuarios/$(uid)).data.nit_ips ==
         get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.nit);

      // Crear: solo registro.html — usuario autenticado crea su propio doc.
      // No puede autoasignarse un plan de pago al registrarse — 'plan' queda
      // ausente o en 'basico' (el más restrictivo) hasta que un admin lo cambie.
      allow create: if isOwner(uid) &&
        request.resource.data.rol == 'pendiente' &&
        request.resource.data.activo == false &&
        (!('plan' in request.resource.data) || request.resource.data.plan == 'basico');

      // Actualizar propio perfil; admin puede actualizar cualquiera;
      // director puede actualizar rol_ips de miembros de su IPS.
      //
      // SEGURIDAD: el dueño de la cuenta (isOwner) YA NO puede escribir
      // cualquier campo libremente — antes podía auto-asignarse rol:'admin'
      // o el NIT de otra IPS real sin ninguna verificación. Ahora solo puede:
      //   Caso 1) editar campos de perfil normales, y cambiar su propio NIT
      //           únicamente si aún no tiene uno (primera vez) o si el nuevo
      //           NIT está autorizado en ips_autorizadas/{nit} (selector de
      //           "varias IPS" — Feature 2).
      //   Caso 2) aceptar una invitación de equipo válida y sin usar, dirigida
      //           a su propio correo (Feature 1 — /invitacion/[code]),
      //           verificando el documento invitaciones/{code} referenciado.
      allow update: if isAdmin() ||
        (
          planSinCambios() &&
          (
            (
              isAuthenticated() &&
              ('nit_ips' in get(/databases/$(database)/documents/usuarios/$(uid)).data) &&
              get(/databases/$(database)/documents/usuarios/$(uid)).data.nit_ips != '' &&
              get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.nit ==
              get(/databases/$(database)/documents/usuarios/$(uid)).data.nit_ips
            ) ||
            (
              isOwner(uid) &&
              (
                (
                  request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['nombre','nombreContacto','cargo','telefono','ciudad','tipoIPS','nit']) &&
                  (
                    request.resource.data.nit == resource.data.nit ||
                    resource.data.nit == '' ||
                    exists(/databases/$(database)/documents/usuarios/$(uid)/ips_autorizadas/$(request.resource.data.nit))
                  )
                )
                ||
                (
                  resource.data.rol == 'pendiente' && resource.data.activo == false &&
                  request.resource.data.rol == 'cliente' &&
                  request.resource.data.activo == true &&
                  request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['rol','activo','estado','nit_ips','rol_ips','nombre','codigoInvitacionUsada']) &&
                  ('codigoInvitacionUsada' in request.resource.data) &&
                  exists(/databases/$(database)/documents/invitaciones/$(request.resource.data.codigoInvitacionUsada)) &&
                  get(/databases/$(database)/documents/invitaciones/$(request.resource.data.codigoInvitacionUsada)).data.estado == 'pendiente' &&
                  get(/databases/$(database)/documents/invitaciones/$(request.resource.data.codigoInvitacionUsada)).data.email == resource.data.email &&
                  request.resource.data.nit_ips == get(/databases/$(database)/documents/invitaciones/$(request.resource.data.codigoInvitacionUsada)).data.nit
                )
              )
            )
          )
        );

      // Eliminar: solo admin
      allow delete: if isAdmin();

      // ── IPS autorizadas (Feature 2 — un usuario administrando varias IPS) ──
      // Habilita a este uid a cambiar su NIT activo a uno adicional. Solo lo
      // otorga el dueño real de ese NIT (su propio `nit` coincide) o un admin
      // — nunca el propio uid, para que no se autoasigne acceso a otra IPS.
      match /ips_autorizadas/{nit} {
        allow read: if isOwner(uid) || isAdmin() ||
          (isAuthenticated() &&
           get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.nit == nit);
        // Crear: el dueño real de `nit` (o un admin) otorga el acceso — pero
        // solo si la cuenta beneficiaria (uid) tiene plan Enterprise. El plan
        // "Red de IPS" (administrar varias IPS) es exclusivo de Enterprise /
        // cotización especial, según la página de precios.
        allow create: if isAuthenticated() &&
          request.resource.data.nit == nit &&
          (isAdmin() ||
           (
             get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.nit == nit &&
             ('plan' in get(/databases/$(database)/documents/usuarios/$(uid)).data) &&
             get(/databases/$(database)/documents/usuarios/$(uid)).data.plan == 'enterprise'
           ));
        allow update: if false;
        allow delete: if isAdmin() || isOwner(uid) ||
          (isAuthenticated() &&
           get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.nit == nit);
      }

      // ── PQRS ──────────────────────────────────────────────────────────────
      // Solo el propietario de la cuenta o un admin puede leer/escribir sus PQRS
      match /pqrs/{id} {
        allow read, write: if isOwner(uid) || isAdmin();
      }

      // ── PREM/PROM ─────────────────────────────────────────────────────────
      // Las respuestas del paciente SOLO se crean desde el Worker (token de
      // servicio, endpoint /prem-prom) — no hay una regla pública de escritura
      // directa aquí. El dueño de la cuenta o un admin puede leer/moderar.
      match /prem_prom/{id} {
        allow read, write: if isOwner(uid) || isAdmin();
      }

      // ── Incidentes y Eventos Adversos ────────────────────────────────────
      match /incidentes/{id} {
        allow read, write: if isOwner(uid) || isAdmin();
      }

      // ── Bitácora de Gobernanza ────────────────────────────────────────────
      match /bitacora/{id} {
        allow read, write: if isOwner(uid) || isAdmin();
      }

      // ── SG-SST (documento único 'main') ──────────────────────────────────
      match /sst/{docId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
    }

    // ════════════════════════════════════════════════════════════════════════
    // ips/{nit}/data/{key} — datos de auditoría legacy por IPS
    // ════════════════════════════════════════════════════════════════════════
    match /ips/{nit} {
      allow read: if isAdmin();
      allow write: if isAdmin();

      match /data/{key} {
        // Acceso compartido por IPS: uid == nit (legacy), mismo NIT o admin
        allow read, write: if isAuthenticated() &&
          (request.auth.uid == nit ||
           get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.nit == nit ||
           get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.nit_ips == nit ||
           isAdmin());
      }
    }

    // ════════════════════════════════════════════════════════════════════════
    // capas/{id} — módulo CAPA / Plan de Mejoramiento PAMEC
    // Soporta acceso por uid (personal) y por nit (equipo IPS)
    // ════════════════════════════════════════════════════════════════════════
    match /capas/{id} {
      allow read: if isAuthenticated() && (
        resource.data.uid == request.auth.uid ||
        sameNIT(resource.data.nit) ||
        isAdmin()
      );

      // Al crear: solo verificar uid — nit puede ser vacío si el usuario no lo tiene configurado
      allow create: if isAuthenticated() &&
        request.resource.data.uid == request.auth.uid;

      allow update, delete: if isAuthenticated() && (
        resource.data.uid == request.auth.uid ||
        sameNIT(resource.data.nit) ||
        isAdmin()
      );
    }

    // ════════════════════════════════════════════════════════════════════════
    // informes_auditoria/{id} — Informes formales de auditoría/eventualidad
    // (introducción, justificación, objetivos, metodología, alcance,
    // hallazgos, conclusiones, recomendaciones, salvedad). Mismo patrón
    // uid/nit que capas — visible a todo el equipo IPS por NIT.
    // ════════════════════════════════════════════════════════════════════════
    match /informes_auditoria/{id} {
      allow read: if isAuthenticated() && (
        resource.data.uid == request.auth.uid ||
        sameNIT(resource.data.nit) ||
        isAdmin()
      );

      allow create: if isAuthenticated() &&
        request.resource.data.uid == request.auth.uid;

      allow update, delete: if isAuthenticated() && (
        resource.data.uid == request.auth.uid ||
        sameNIT(resource.data.nit) ||
        isAdmin()
      );
    }

    // ════════════════════════════════════════════════════════════════════════
    // bitacora_gobernanza/{id} — Bitácora de Gobernanza, compartida por IPS
    // (antes era usuarios/{uid}/bitacora — subcolección solo para el dueño;
    // se migra a colección de nivel superior con el mismo patrón que capas,
    // para que todo el Equipo IPS vea la misma bitácora). Cada entrada puede
    // ser manual (creada desde la pantalla) o automática (otros módulos la
    // registran vía registrarBitacora() — ver web/lib/useBitacora.ts). No se
    // edita una vez creada, solo se crea o se borra.
    // ════════════════════════════════════════════════════════════════════════
    match /bitacora_gobernanza/{id} {
      allow read: if isAuthenticated() && (
        resource.data.uid == request.auth.uid ||
        sameNIT(resource.data.nit) ||
        isAdmin()
      );

      // Al crear: solo verificar uid — nit puede ser vacío si el usuario no lo
      // tiene configurado (mismo criterio que capas/{id}).
      allow create: if isAuthenticated() &&
        request.resource.data.uid == request.auth.uid;

      allow update: if false;

      allow delete: if isAuthenticated() && (
        resource.data.uid == request.auth.uid ||
        sameNIT(resource.data.nit) ||
        isAdmin()
      );
    }

    // ════════════════════════════════════════════════════════════════════════
    // vencimientos/{id} — módulo de vencimientos personal
    // ════════════════════════════════════════════════════════════════════════
    match /vencimientos/{id} {
      allow read: if isAuthenticated() && (
        resource.data.uid == request.auth.uid ||
        sameNIT(resource.data.nit) ||
        isAdmin()
      );

      allow create: if isAuthenticated() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.nit == get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.nit;

      allow update, delete: if isAuthenticated() && (
        resource.data.uid == request.auth.uid ||
        sameNIT(resource.data.nit) ||
        isAdmin()
      );
    }

    // ════════════════════════════════════════════════════════════════════════
    // indicadores/{id} — módulo indicadores Res. 256/2016
    // Soporta acceso por uid (personal) y por nit (equipo IPS)
    // ════════════════════════════════════════════════════════════════════════
    match /indicadores/{id} {
      allow read: if isAuthenticated() && (
        resource.data.uid == request.auth.uid ||
        sameNIT(resource.data.nit) ||
        isAdmin()
      );

      allow create: if isAuthenticated() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.nit == get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.nit;

      allow update, delete: if isAuthenticated() && (
        resource.data.uid == request.auth.uid ||
        sameNIT(resource.data.nit) ||
        isAdmin()
      );
    }

    // ════════════════════════════════════════════════════════════════════════
    // iaas_casos/{id}, iaas_denominadores/{id} — Vigilancia IAAS (SIVIGILA
    // eventos 357/359 IAD y 352/362 IAPMQ). Mismo patrón que indicadores/{id}:
    // acceso compartido por uid (personal) o por nit (equipo IPS).
    // ════════════════════════════════════════════════════════════════════════
    match /iaas_casos/{id} {
      allow read: if isAuthenticated() && (
        resource.data.uid == request.auth.uid ||
        sameNIT(resource.data.nit) ||
        isAdmin()
      );

      allow create: if isAuthenticated() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.nit == get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.nit;

      allow update, delete: if isAuthenticated() && (
        resource.data.uid == request.auth.uid ||
        sameNIT(resource.data.nit) ||
        isAdmin()
      );
    }

    match /iaas_denominadores/{id} {
      allow read: if isAuthenticated() && (
        resource.data.uid == request.auth.uid ||
        sameNIT(resource.data.nit) ||
        isAdmin()
      );

      allow create: if isAuthenticated() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.nit == get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.nit;

      allow update, delete: if isAuthenticated() && (
        resource.data.uid == request.auth.uid ||
        sameNIT(resource.data.nit) ||
        isAdmin()
      );
    }

    // ════════════════════════════════════════════════════════════════════════
    // invitaciones/{code} — sistema de invitaciones de equipo IPS
    // Solo visible para miembros de la misma IPS o el invitado por email
    // ════════════════════════════════════════════════════════════════════════
    match /invitaciones/{code} {
      // Leer: solo el creador, miembros del mismo NIT, el invitado por email, o admin
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.creadoPor == request.auth.uid ||
        resource.data.email == get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.email ||
        sameNIT(resource.data.nit)
      );

      allow create: if isAuthenticated() &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol in
          ['cliente', 'piloto', 'admin'] &&
        request.resource.data.creadoPor == request.auth.uid &&
        // El NIT de la invitación debe coincidir con el NIT del creador
        request.resource.data.nit == get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.nit;

      allow update: if isAuthenticated() &&
        (resource.data.creadoPor == request.auth.uid || isAdmin() ||
         resource.data.email == get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.email);

      allow delete: if isAuthenticated() &&
        (resource.data.creadoPor == request.auth.uid || isAdmin());
    }

    // ════════════════════════════════════════════════════════════════════════
    // solicitudes_acceso_ips/{id} — Feature 2: un usuario con cuenta existente
    // pide acceso a una IPS distinta a la suya (identificada por NIT). El
    // dueño real de ese NIT (o un admin) la aprueba o rechaza; al aprobar, el
    // propio dueño crea el documento usuarios/{uid}/ips_autorizadas/{nit}
    // correspondiente (ver esa regla arriba) — nunca el solicitante, para que
    // nadie pueda autoconcederse acceso a una IPS ajena.
    // ════════════════════════════════════════════════════════════════════════
    match /solicitudes_acceso_ips/{id} {
      // Leer: el propio solicitante, el dueño del NIT solicitado, o admin
      allow read: if isAuthenticated() && (
        resource.data.uid == request.auth.uid ||
        isAdmin() ||
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.nit == resource.data.nit
      );

      // Crear: cualquier usuario autenticado solicita para sí mismo, con su
      // propio correo real (no puede suplantar a otro) y siempre en pendiente.
      // Requiere plan Enterprise propio — el acceso a otra IPS ("Red de IPS")
      // es exclusivo de Enterprise / cotización especial (ver página de
      // precios); así el dueño de la IPS solicitada nunca ve una solicitud
      // que de todos modos no podría aprobar.
      allow create: if isAuthenticated() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.estado == 'pendiente' &&
        request.resource.data.nit is string && request.resource.data.nit != '' &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol in
          ['cliente', 'piloto', 'admin'] &&
        request.resource.data.emailSolicitante ==
          get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.email &&
        (
          isAdmin() ||
          (
            ('plan' in get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data) &&
            get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.plan == 'enterprise'
          )
        );

      // Actualizar: solo el dueño real del NIT solicitado (o admin) puede
      // resolver la solicitud, solo desde pendiente, y solo puede tocar el
      // veredicto — nunca reescribir de quién es o a qué NIT aplica.
      allow update: if isAuthenticated() &&
        resource.data.estado == 'pendiente' &&
        request.resource.data.estado in ['aprobada', 'rechazada'] &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['estado', 'resueltoPor', 'resueltoPorNombre', 'resueltoEn']) &&
        request.resource.data.resueltoPor == request.auth.uid &&
        (isAdmin() ||
         get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.nit == resource.data.nit);

      // Eliminar: el propio solicitante puede retirar su solicitud mientras
      // siga pendiente, o un admin en cualquier momento.
      allow delete: if isAdmin() ||
        (isAuthenticated() && resource.data.uid == request.auth.uid && resource.data.estado == 'pendiente');
    }

    // ════════════════════════════════════════════════════════════════════════
    // pilotos/{nit} — seguimiento del programa piloto
    // ════════════════════════════════════════════════════════════════════════
    match /pilotos/{nit} {
      allow read: if isAuthenticated() &&
        (request.auth.uid == nit || isAdmin());
      allow write: if isAdmin();
    }

    // ════════════════════════════════════════════════════════════════════════
    // prospectos/{id} — CRM interno (solo admin)
    // ════════════════════════════════════════════════════════════════════════
    match /prospectos/{id} {
      allow read, write: if isAdmin();
    }

    // ════════════════════════════════════════════════════════════════════════
    // leads/{id} — formulario demo público desde index.html
    // ════════════════════════════════════════════════════════════════════════
    match /leads/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ════════════════════════════════════════════════════════════════════════
    // crm_contactos/{id}, crm_actividad/{id} — CRM interno unificado
    // (reemplaza el uso directo de prospectos/leads en /admin; ambas
    // colecciones se siguen migrando hacia acá pero no se borran)
    // ════════════════════════════════════════════════════════════════════════
    match /crm_contactos/{id} {
      allow read, write: if isAdmin();
    }

    match /crm_actividad/{id} {
      allow read, write: if isAdmin();
    }

    // ════════════════════════════════════════════════════════════════════════
    // normalis_orgs/{orgId} — sincronización secundaria (normalis-main.js)
    // orgId = NIT de la IPS — solo accesible para miembros del mismo NIT o admin
    // ════════════════════════════════════════════════════════════════════════
    match /normalis_orgs/{orgId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.nit == orgId ||
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.nit_ips == orgId
      );
      allow write: if isAuthenticated() && (
        isAdmin() ||
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.nit == orgId ||
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.nit_ips == orgId
      );
    }

    // ════════════════════════════════════════════════════════════════════════
    // auditorias/{docId} — sesiones de auditoría de habilitación (Next.js app)
    // docId = {uid}_{segmento} — solo el propietario puede acceder
    // ════════════════════════════════════════════════════════════════════════
    match /auditorias/{docId} {
      // resource == null cuando el doc no existe — permitir lectura para que
      // Promise.allSettled pueda verificar qué segmentos existen sin error de permisos
      allow read: if isAuthenticated() && (
        resource == null ||
        resource.data.uid == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() &&
        request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAuthenticated() && (
        resource.data.uid == request.auth.uid || isAdmin()
      );
    }

    // ════════════════════════════════════════════════════════════════════════
    // gap1732/{uid} — Análisis de brecha Res. 1732/2026 (Next.js app)
    // docId = uid del usuario
    // ════════════════════════════════════════════════════════════════════════
    match /gap1732/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    // ════════════════════════════════════════════════════════════════════════
    // pamec/{nit} — Módulo PAMEC (Plan de Auditoría para el Mejoramiento)
    // docId = NIT de la IPS
    // ════════════════════════════════════════════════════════════════════════
    match /pamec/{nit} {
      allow read: if isAuthenticated() && (
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.nit == nit ||
        isAdmin()
      );
      allow write: if isAuthenticated() && (
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.nit == nit ||
        isAdmin()
      );
    }

    // ════════════════════════════════════════════════════════════════════════
    // simulacros/{nit} — Módulo Simulacros / Planes de emergencia
    // docId = NIT de la IPS
    // ════════════════════════════════════════════════════════════════════════
    match /simulacros/{nit} {
      allow read: if isAuthenticated() && (
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.nit == nit ||
        isAdmin()
      );
      allow write: if isAuthenticated() && (
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.nit == nit ||
        isAdmin()
      );
    }

    // ════════════════════════════════════════════════════════════════════════
    // riesgos/{uid}/items/{id} — Gestión de riesgos ISO 31000 (cumplimiento)
    // Subcollection bajo el uid del usuario
    // ════════════════════════════════════════════════════════════════════════
    match /riesgos/{uid}/items/{id} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    // ════════════════════════════════════════════════════════════════════════
    // benchmarks/{docId} — Módulo Benchmarking entre IPS
    // ════════════════════════════════════════════════════════════════════════
    match /benchmarks/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAuthenticated() && (
        resource.data.uid == request.auth.uid || isAdmin()
      );
    }

    // ════════════════════════════════════════════════════════════════════════
    // PROA — Programa de Optimización del Uso de Antimicrobianos
    // Res. 2471/2022 · Plan RAM 2025-2030
    // ════════════════════════════════════════════════════════════════════════
    match /proa_checklist/{docId} {
      allow read: if isAuthenticated() && (
        resource.data.nit == get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.nit ||
        isAdmin()
      );
      allow create: if isAuthenticated() &&
        request.resource.data.nit == get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.nit;
      allow update, delete: if isAuthenticated() && (
        resource.data.nit == get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.nit ||
        isAdmin()
      );
    }

    match /proa_intervenciones/{docId} {
      allow read: if isAuthenticated() && (
        resource.data.nit == get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.nit ||
        isAdmin()
      );
      allow create: if isAuthenticated() &&
        request.resource.data.nit == get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.nit;
      allow update, delete: if isAuthenticated() && (
        resource.data.nit == get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.nit ||
        isAdmin()
      );
    }

    match /proa_consumos/{docId} {
      allow read: if isAuthenticated() && (
        resource.data.nit == get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.nit ||
        isAdmin()
      );
      allow create: if isAuthenticated() &&
        request.resource.data.nit == get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.nit;
      allow update, delete: if isAuthenticated() && (
        resource.data.nit == get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.nit ||
        isAdmin()
      );
    }

    // proa_iaas — IAAS por microorganismo resistente (art. 20.6 Res. 2471/2022)
    // Colección nueva (no hereda datos previos): el nit queda inmutable en
    // update para que un usuario no pueda reasignar el documento a otra IPS.
    match /proa_iaas/{docId} {
      allow read: if isAuthenticated() && (
        resource.data.nit == get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.nit ||
        isAdmin()
      );
      allow create: if isAuthenticated() &&
        request.resource.data.nit == get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.nit;
      allow update: if isAuthenticated() && (
        isAdmin() || (
          resource.data.nit == get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.nit &&
          request.resource.data.nit == resource.data.nit
        )
      );
      allow delete: if isAuthenticated() && (
        resource.data.nit == get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.nit ||
        isAdmin()
      );
    }

    // proa_autorizaciones — registro de autorización previa antibióticos
    // restringidos (carbapenémicos y colistina, art. 2.3 Res. 2471/2022)
    match /proa_autorizaciones/{docId} {
      allow read: if isAuthenticated() && (
        resource.data.nit == get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.nit ||
        isAdmin()
      );
      allow create: if isAuthenticated() &&
        request.resource.data.nit == get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.nit;
      allow update: if isAuthenticated() && (
        isAdmin() || (
          resource.data.nit == get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.nit &&
          request.resource.data.nit == resource.data.nit
        )
      );
      allow delete: if isAuthenticated() && (
        resource.data.nit == get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.nit ||
        isAdmin()
      );
    }

    // proa_informe_anual — informe anual PROA + estado de envío a la
    // Secretaría de Salud territorial (art. 20.6 + 12.5 Res. 2471/2022)
    match /proa_informe_anual/{docId} {
      allow read: if isAuthenticated() && (
        resource.data.nit == get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.nit ||
        isAdmin()
      );
      allow create: if isAuthenticated() &&
        request.resource.data.nit == get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.nit;
      allow update: if isAuthenticated() && (
        isAdmin() || (
          resource.data.nit == get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.nit &&
          request.resource.data.nit == resource.data.nit
        )
      );
      allow delete: if isAuthenticated() && (
        resource.data.nit == get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.nit ||
        isAdmin()
      );
    }

    // proa_evaluacion_territorial — reproducción del instrumento oficial de
    // evaluación PROA que usan las Secretarías de Salud territoriales (61
    // ítems / 3 secciones). La UI de NormaLis solo crea registros nuevos
    // (cada evaluación es una foto histórica, como el diligenciamiento en
    // papel/Excel — no se edita); se sigue el mismo patrón de allow update
    // que las demás colecciones proa_* (isAdmin() o nit-pinned) para dejar
    // una vía de corrección administrativa sin exponerla en la UI normal.
    match /proa_evaluacion_territorial/{docId} {
      allow read: if isAuthenticated() && (
        resource.data.nit == get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.nit ||
        isAdmin()
      );
      allow create: if isAuthenticated() &&
        request.resource.data.nit == get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.nit;
      allow update: if isAuthenticated() && (
        isAdmin() || (
          resource.data.nit == get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.nit &&
          request.resource.data.nit == resource.data.nit
        )
      );
      allow delete: if isAuthenticated() && (
        resource.data.nit == get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.nit ||
        isAdmin()
      );
    }

    // ════════════════════════════════════════════════════════════════════════
    // Subcollections adicionales de usuarios/{uid}
    // ════════════════════════════════════════════════════════════════════════
    match /usuarios/{uid}/consentimientos/{id} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    match /usuarios/{uid}/firmaDocs/{id} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    match /usuarios/{uid}/profesionales/{id} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    // ════════════════════════════════════════════════════════════════════════
    // api_keys/{id} — llaves de la API pública de integraciones (HCE, etc.)
    // El id del documento es el hash SHA-256 de la llave real; el valor en
    // texto plano nunca se guarda en Firestore, solo se muestra una vez al
    // crearla desde /dashboard/integraciones. El Worker usa el service
    // account (isAdmin) para autenticar POST /api/v1/incidentes.
    // ════════════════════════════════════════════════════════════════════════
    match /api_keys/{id} {
      allow read: if isAuthenticated() && (
        resource.data.uid == request.auth.uid || isAdmin()
      );

      allow create: if isAuthenticated() &&
        request.resource.data.uid == request.auth.uid;

      allow update, delete: if isAuthenticated() && (
        resource.data.uid == request.auth.uid || isAdmin()
      );
    }

    // ════════════════════════════════════════════════════════════════════════
    // bitacora_seguridad/{id} — bitácora de seguridad inmutable (ISO 27001 A.12)
    // Escrita EXCLUSIVAMENTE por el Worker (POST /audit), autenticado como
    // cron@normalis.co (isAdmin). Ningún usuario, ni siquiera admin, puede
    // editar o borrar una entrada una vez creada — eso es lo que la hace
    // confiable como evidencia de auditoría.
    // ════════════════════════════════════════════════════════════════════════
    match /bitacora_seguridad/{id} {
      allow read: if isAuthenticated() && (
        resource.data.uid == request.auth.uid ||
        sameNIT(resource.data.nit) ||
        isAdmin()
      );
      // Solo la cuenta cron del Worker, NUNCA un admin humano — ver isCronWorker().
      allow create: if isCronWorker();
      allow update, delete: if false;
    }

    // ════════════════════════════════════════════════════════════════════════
    // firmas/{id} — pruebas de firma electrónica inmutables (Ley 527/1999 Art. 7)
    // Escrita EXCLUSIVAMENTE por el Worker (POST /firmar), autenticado como
    // cron@normalis.co, con un HMAC sellado con un secreto que el cliente
    // nunca ve. `create` exige isCronWorker() — no isAdmin() — precisamente
    // para que ni siquiera un admin humano (ni uno comprometido) pueda
    // escribir aquí directo desde el cliente sin pasar por el HMAC del
    // Worker. Igual que bitacora_seguridad: ni un usuario ni un admin
    // pueden editar o borrar una firma ya creada — de lo contrario no
    // serviría como evidencia de que el firmante aprobó ese contenido exacto.
    // ════════════════════════════════════════════════════════════════════════
    match /firmas/{id} {
      allow read: if isAuthenticated() && (
        resource.data.uid == request.auth.uid ||
        sameNIT(resource.data.nit) ||
        isAdmin()
      );
      // Solo la cuenta cron del Worker, NUNCA un admin humano — ver isCronWorker().
      allow create: if isCronWorker();
      allow update, delete: if false;
    }

    // ════════════════════════════════════════════════════════════════════════
    // documentos_dms/{id} — Gestor Documental: versionado + flujo de aprobación
    // Mismo patrón de acceso compartido por NIT que capas/vencimientos/
    // indicadores. Cualquiera del equipo puede crear una versión en borrador
    // y moverla a revisión; SOLO admin puede aprobarla, y únicamente si ya
    // trae un firmaId (la aprobación se sella primero con el mismo HMAC de
    // /firmar — ver web/lib/useDocumentosDMS.ts). Una vez aprobada, la
    // versión queda inmutable salvo el tránsito automático a "obsoleto"
    // cuando la reemplaza una versión más nueva.
    // ════════════════════════════════════════════════════════════════════════
    match /documentos_dms/{id} {
      allow read: if isAuthenticated() && (
        resource.data.uid == request.auth.uid ||
        sameNIT(resource.data.nit) ||
        isAdmin()
      );

      allow create: if isAuthenticated() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.estado == 'borrador' &&
        request.resource.data.nit == get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.nit;

      allow update: if isAuthenticated() &&
        (sameNIT(resource.data.nit) || isAdmin()) &&
        // Una vez aprobada, solo se puede tocar para pasarla a obsoleto
        // (y eso solo lo hace el propio flujo de aprobación de la versión
        // siguiente, ejecutado por un admin).
        (resource.data.estado != 'aprobado' ||
          (isAdmin() && request.resource.data.estado == 'obsoleto')) &&
        // Nadie puede auto-aprobar sin admin, ni aprobar sin sello HMAC ya emitido.
        (request.resource.data.estado != 'aprobado' ||
          (isAdmin() &&
           request.resource.data.firmaId is string &&
           request.resource.data.firmaId != ''));

      allow delete: if false;

      // ── Socializaciones — acuse individual de "leí y entendí" ─────────────
      match /socializaciones/{uid} {
        allow read: if isAuthenticated() && (
          isOwner(uid) ||
          sameNIT(get(/databases/$(database)/documents/documentos_dms/$(id)).data.nit) ||
          isAdmin()
        );
        allow create: if isOwner(uid);
        allow update, delete: if false;
      }
    }

    // ════════════════════════════════════════════════════════════════════════
    // equipos_biomedicos/{id} — CMMS: inventario de equipos biomédicos
    // (Res. 1732/2026, Estándar de Dotación). Mismo patrón de acceso
    // compartido por NIT que capas/vencimientos. La hoja de vida
    // (mantenimientos) es de solo-creación — un registro de mantenimiento
    // nunca se edita ni se borra una vez guardado, igual que socializaciones.
    // ════════════════════════════════════════════════════════════════════════
    match /equipos_biomedicos/{id} {
      allow read: if isAuthenticated() && (
        resource.data.uid == request.auth.uid ||
        sameNIT(resource.data.nit) ||
        isAdmin()
      );

      allow create: if isAuthenticated() &&
        request.resource.data.uid == request.auth.uid;

      allow update: if isAuthenticated() && (
        resource.data.uid == request.auth.uid ||
        sameNIT(resource.data.nit) ||
        isAdmin()
      );

      allow delete: if false;

      // ── Hoja de vida — mantenimientos preventivos/correctivos ────────────
      match /mantenimientos/{mid} {
        allow read: if isAuthenticated() && (
          sameNIT(get(/databases/$(database)/documents/equipos_biomedicos/$(id)).data.nit) ||
          get(/databases/$(database)/documents/equipos_biomedicos/$(id)).data.uid == request.auth.uid ||
          isAdmin()
        );
        allow create: if isAuthenticated() && (
          sameNIT(get(/databases/$(database)/documents/equipos_biomedicos/$(id)).data.nit) ||
          get(/databases/$(database)/documents/equipos_biomedicos/$(id)).data.uid == request.auth.uid ||
          isAdmin()
        );
        allow update, delete: if false;
      }
    }

    // ════════════════════════════════════════════════════════════════════════
    // infraestructura_areas/{id} — Gestión de Infraestructura Física
    // (Res. 1732/2026, Estándar de Infraestructura). Mismo patrón de acceso
    // compartido por NIT y de hoja de vida de solo-creación que
    // equipos_biomedicos/mantenimientos.
    // ════════════════════════════════════════════════════════════════════════
    match /infraestructura_areas/{id} {
      allow read: if isAuthenticated() && (
        resource.data.uid == request.auth.uid ||
        sameNIT(resource.data.nit) ||
        isAdmin()
      );

      allow create: if isAuthenticated() &&
        request.resource.data.uid == request.auth.uid;

      allow update: if isAuthenticated() && (
        resource.data.uid == request.auth.uid ||
        sameNIT(resource.data.nit) ||
        isAdmin()
      );

      allow delete: if false;

      // ── Hoja de vida — inspecciones periódicas ────────────────────────────
      match /inspecciones/{iid} {
        allow read: if isAuthenticated() && (
          sameNIT(get(/databases/$(database)/documents/infraestructura_areas/$(id)).data.nit) ||
          get(/databases/$(database)/documents/infraestructura_areas/$(id)).data.uid == request.auth.uid ||
          isAdmin()
        );
        allow create: if isAuthenticated() && (
          sameNIT(get(/databases/$(database)/documents/infraestructura_areas/$(id)).data.nit) ||
          get(/databases/$(database)/documents/infraestructura_areas/$(id)).data.uid == request.auth.uid ||
          isAdmin()
        );
        // Excepción: sí se permite update para escribir capaId una vez creada
        // la CAPA vinculada — el resto de campos de una inspección ya
        // guardada nunca deberían cambiar, pero Firestore Rules no puede
        // restringir "solo este campo" sin duplicar toda la validación, así
        // que se confía en que el cliente (vincularCapaAInspeccion) solo
        // toca capaId, igual que el patrón ya usado en Análisis de Riesgo.
        allow update: if isAuthenticated() && (
          sameNIT(get(/databases/$(database)/documents/infraestructura_areas/$(id)).data.nit) ||
          get(/databases/$(database)/documents/infraestructura_areas/$(id)).data.uid == request.auth.uid ||
          isAdmin()
        );
        allow delete: if false;
      }
    }

    // ════════════════════════════════════════════════════════════════════════
    // medicamentos_lotes/{id} — Gestión de Medicamentos y Dispositivos:
    // inventario de lotes con vencimiento (Res. 1732/2026, Estándar de
    // Medicamentos y Dispositivos Médicos). Mismo patrón compartido por NIT
    // que capas/vencimientos — sin subcolección, colección plana.
    // ════════════════════════════════════════════════════════════════════════
    match /medicamentos_lotes/{id} {
      allow read: if isAuthenticated() && (
        resource.data.uid == request.auth.uid ||
        sameNIT(resource.data.nit) ||
        isAdmin()
      );
      allow create: if isAuthenticated() &&
        request.resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.uid == request.auth.uid ||
        sameNIT(resource.data.nit) ||
        isAdmin()
      );
      allow delete: if false;
    }

    // ════════════════════════════════════════════════════════════════════════
    // medicamentos_verificaciones/{id} — verificaciones periódicas del
    // Servicio Farmacéutico. Registro de solo-creación (como bitacora_
    // gobernanza) salvo el campo capaId, que se actualiza al vincular una
    // CAPA creada desde los hallazgos de la verificación.
    // ════════════════════════════════════════════════════════════════════════
    match /medicamentos_verificaciones/{id} {
      allow read: if isAuthenticated() && (
        resource.data.uid == request.auth.uid ||
        sameNIT(resource.data.nit) ||
        isAdmin()
      );
      allow create: if isAuthenticated() &&
        request.resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.uid == request.auth.uid ||
        sameNIT(resource.data.nit) ||
        isAdmin()
      );
      allow delete: if false;
    }

    // ════════════════════════════════════════════════════════════════════════
    // historia_clinica_auditorias/{id} — Auditoría de Historia Clínica por
    // muestreo (Res. 1732/2026, Estándar de Historia Clínica). Registro de
    // solo-creación salvo capaId, mismo patrón que medicamentos_verificaciones.
    // ════════════════════════════════════════════════════════════════════════
    match /historia_clinica_auditorias/{id} {
      allow read: if isAuthenticated() && (
        resource.data.uid == request.auth.uid ||
        sameNIT(resource.data.nit) ||
        isAdmin()
      );
      allow create: if isAuthenticated() &&
        request.resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.uid == request.auth.uid ||
        sameNIT(resource.data.nit) ||
        isAdmin()
      );
      allow delete: if false;
    }

    // ════════════════════════════════════════════════════════════════════════
    // historia_clinica_ihce/{id} — estado declarado de integración a la red
    // nacional de Interoperabilidad de Historia Clínica Electrónica (IHCE).
    // Documento singleton: id = nit (o uid si no hay nit) — 1 registro por
    // IPS, no un log. Se permite update completo (declarar/actualizar
    // estado), igual que interdependencia_convenios.
    // ════════════════════════════════════════════════════════════════════════
    match /historia_clinica_ihce/{id} {
      allow read: if isAuthenticated() && (
        resource.data.uid == request.auth.uid ||
        sameNIT(resource.data.nit) ||
        isAdmin()
      );
      allow create: if isAuthenticated() &&
        request.resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.uid == request.auth.uid ||
        sameNIT(resource.data.nit) ||
        isAdmin()
      );
      allow delete: if false;
    }

    // ════════════════════════════════════════════════════════════════════════
    // interdependencia_convenios/{id} — registro de convenios con la red de
    // prestadores (Res. 1732/2026, Estándar de Interdependencia). Se permite
    // update completo (renovar vigencia, cambiar contacto) — no es un log
    // de solo-creación como las verificaciones.
    // ════════════════════════════════════════════════════════════════════════
    match /interdependencia_convenios/{id} {
      allow read: if isAuthenticated() && (
        resource.data.uid == request.auth.uid ||
        sameNIT(resource.data.nit) ||
        isAdmin()
      );
      allow create: if isAuthenticated() &&
        request.resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.uid == request.auth.uid ||
        sameNIT(resource.data.nit) ||
        isAdmin()
      );
      allow delete: if false;
    }

    // ════════════════════════════════════════════════════════════════════════
    // interdependencia_verificaciones/{id} — verificaciones periódicas del
    // Estándar de Interdependencia. Registro de solo-creación salvo capaId,
    // mismo patrón que historia_clinica_auditorias/medicamentos_verificaciones.
    // ════════════════════════════════════════════════════════════════════════
    match /interdependencia_verificaciones/{id} {
      allow read: if isAuthenticated() && (
        resource.data.uid == request.auth.uid ||
        sameNIT(resource.data.nit) ||
        isAdmin()
      );
      allow create: if isAuthenticated() &&
        request.resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.uid == request.auth.uid ||
        sameNIT(resource.data.nit) ||
        isAdmin()
      );
      allow delete: if false;
    }

    // ════════════════════════════════════════════════════════════════════════
    // eventos_vigilancia/{id} — Vigilancia Sanitaria: farmacovigilancia,
    // tecnovigilancia y reactivovigilancia (Res. 1732/2026, Estándar de
    // Medicamentos y Dispositivos Médicos, Numeral 6).
    //
    // Al crear: se exige que el nit del evento coincida con el nit del propio
    // usuario (igual que vencimientos/indicadores/documentos_dms) — evita que
    // un usuario autenticado inyecte eventos falsos bajo el NIT de otra IPS.
    //
    // Al actualizar: los HECHOS del evento (qué pasó, cuándo, qué tan serio)
    // quedan bloqueados para usuarios normales una vez creado el registro —
    // solo se puede avanzar el seguimiento del caso (estado del reporte,
    // fecha/radicado INVIMA, acciones tomadas, responsable). Es un registro
    // de auditoría regulatoria: reescribir los hechos originales borraría la
    // evidencia de un plazo incumplido. isAdmin() puede corregir errores de
    // digitación genuinos si hace falta.
    // ════════════════════════════════════════════════════════════════════════
    match /eventos_vigilancia/{id} {
      allow read: if isAuthenticated() && (
        resource.data.uid == request.auth.uid ||
        sameNIT(resource.data.nit) ||
        isAdmin()
      );

      allow create: if isAuthenticated() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.nit == get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.nit;

      allow update: if isAuthenticated() && (
        isAdmin() || (
          (resource.data.uid == request.auth.uid || sameNIT(resource.data.nit)) &&
          request.resource.data.tipoVigilancia    == resource.data.tipoVigilancia &&
          request.resource.data.productoNombre    == resource.data.productoNombre &&
          request.resource.data.descripcionEvento == resource.data.descripcionEvento &&
          request.resource.data.fechaOcurrencia   == resource.data.fechaOcurrencia &&
          request.resource.data.fechaConocimiento == resource.data.fechaConocimiento &&
          request.resource.data.severidad         == resource.data.severidad &&
          request.resource.data.pacienteAfectado  == resource.data.pacienteAfectado &&
          request.resource.data.uid               == resource.data.uid &&
          request.resource.data.nit               == resource.data.nit
        )
      );

      allow delete: if false;
    }

    // ════════════════════════════════════════════════════════════════════════
    // Denegar todo lo demás
    // ════════════════════════════════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }

  }
}

// ════════════════════════════════════════════════════════════════════════
// ⚠️ PASO MANUAL REQUERIDO ANTES DE DESPLEGAR ESTE ARCHIVO
// ════════════════════════════════════════════════════════════════════════
// isCronWorker() (arriba) exige `esCronWorker: true` en el documento
// usuarios/{uid} de la cuenta cron@normalis.co. Sin ese campo, tras
// desplegar estas reglas el Worker perdería la capacidad de escribir en
// `firmas` y `bitacora_seguridad` — es decir, se rompería POST /firmar y
// el registro de eventos de seguridad, en producción.
//
// Antes (o inmediatamente después, con downtime breve) de
// `firebase deploy --only firestore:rules`, en la consola de Firebase
// (Firestore Database > usuarios > <uid de cron@normalis.co>) agregar:
//
//   esCronWorker: true   (boolean)
//
// El uid se encuentra en Authentication > Users, buscando cron@normalis.co.
// ════════════════════════════════════════════════════════════════════════
