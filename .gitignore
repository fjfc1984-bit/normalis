# NormaLis .gitignore

# Logs generados automáticamente
*.log
firebase-check.log
firebase-deploy.log
deploy-v3.log
test-output.txt

# Archivos de trabajo temporales
apply-onboarding-fix.py
normalis_test_runner.py
normalis_test_suite.json
res3100_clean.txt
res3100_alcaldia_clean.txt

# Node modules
node_modules/
functions/

# Claves y secrets
.env
*.env
service-account*.json
.wrangler/

# Cache de build de TypeScript (se regenera solo)
*.tsbuildinfo

# Archivos temporales de FUSE / OneDrive y locks de Office
.fuse_hidden*
~$*

# OS
.DS_Store
Thumbs.db

# Imágenes temporales
page-*.jpg
page*.jpg

# Editores
.vscode/
*.swp
.resend-key
__pycache__/
upload-rag.bat
setup-firebase-secrets.bat
scripts/upload_progress.json

# Videos generados localmente (no van en el repo — usar almacenamiento externo)
*.mp4
*.mov
*.avi
*.webm
