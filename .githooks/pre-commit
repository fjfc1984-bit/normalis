#!/bin/sh
# .githooks/pre-commit
# Compatible con Linux/Mac (bash) y Windows (Git for Windows sh)
# Instalacion: git config core.hooksPath .githooks
# Corre automaticamente en cada git commit.
#
# Flujo:
#   1. Si normalis-repair.sh existe → validate + auto-repair + re-validate
#   2. Fallback: solo validador maestro
#   3. Fallback: validadores individuales

if ! command -v bash >/dev/null 2>&1; then
  echo "  [INFO] bash no disponible — saltando validacion NormaLis"
  exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"

echo ""
echo "============================================================"
echo "  NormaLis — Validacion pre-commit (auto-repair activo)"
echo "============================================================"

# Determinar si algun archivo JS/HTML/CSS fue modificado
MODIFIED=$(git diff --cached --name-only)
JS_HTML_CHANGED=$(echo "$MODIFIED" | grep -qE '\.(html|js|css)$' && echo "1" || echo "0")

# Si no se modifico nada relevante y no es full check, pasar
if [ "$JS_HTML_CHANGED" = "0" ] && [ "${NORMALIS_FULL_CHECK:-0}" != "1" ]; then
  echo "  Sin cambios en HTML/JS/CSS — saltando validacion"
  echo "  COMMIT AUTORIZADO"
  echo "============================================================"
  exit 0
fi

# ── CAMINO PRINCIPAL: repair-then-validate ────────────────────────
if [ -f "$REPO_ROOT/normalis-repair.sh" ]; then

  # Snapshot de archivos ya sucios ANTES de correr el reparador — este repo
  # arrastra ruido preexistente (archivos modificados sin commitear) que no
  # tiene nada que ver con lo que el reparador toque en esta corrida. Sin
  # este snapshot, "git diff --name-only" post-reparación siempre reporta
  # ese ruido viejo como si fuera "recién reparado" y el commit queda
  # pausado para siempre, incluso cuando el reparador no tocó nada.
  BEFORE_DIRTY=$(git diff --name-only 2>/dev/null || true)

  if bash "$REPO_ROOT/normalis-repair.sh" 2>&1; then
    # El repair + validate pasaron
    # Si el reparador modificó archivos, agregarlos al staging automáticamente
    AFTER_DIRTY=$(git diff --name-only 2>/dev/null || true)
    echo "$BEFORE_DIRTY" | sort > /tmp/normalis_before_dirty.txt
    echo "$AFTER_DIRTY"  | sort > /tmp/normalis_after_dirty.txt
    REPAIRED=$(comm -13 /tmp/normalis_before_dirty.txt /tmp/normalis_after_dirty.txt 2>/dev/null || true)
    if [ -n "$REPAIRED" ]; then
      echo ""
      echo "  [AUTO-REPAIR] Archivos reparados en disco:"
      echo "$REPAIRED" | while IFS= read -r f; do echo "    + $f"; done
      echo ""
      echo "  Ejecuta: git add -u && git commit (para incluir las reparaciones)"
      echo "============================================================"
      echo "  COMMIT PAUSADO — re-stagea los archivos reparados"
      echo "============================================================"
      echo ""
      exit 1
    fi
    echo ""
    echo "============================================================"
    echo "  COMMIT AUTORIZADO"
    echo "============================================================"
    echo ""
    exit 0
  else
    echo ""
    echo "============================================================"
    echo "  COMMIT BLOQUEADO — reparacion automatica no suficiente"
    echo "  Ejecuta manualmente: bash normalis-repair.sh --verbose"
    echo "  Luego: bash normalis-validate.sh --verbose"
    echo "============================================================"
    echo ""
    exit 1
  fi

# ── FALLBACK: solo validador maestro ─────────────────────────────
elif [ -f "$REPO_ROOT/normalis-validate.sh" ]; then
  if bash "$REPO_ROOT/normalis-validate.sh" 2>&1; then
    echo ""
    echo "============================================================"
    echo "  COMMIT AUTORIZADO"
    echo "============================================================"
    echo ""
    exit 0
  else
    echo ""
    echo "============================================================"
    echo "  COMMIT BLOQUEADO — corrige los errores criticos primero"
    echo "  Ejecuta: bash normalis-validate.sh --verbose"
    echo "============================================================"
    echo ""
    exit 1
  fi

# ── FALLBACK: validadores individuales ───────────────────────────
else
  echo "  [WARN] normalis-validate.sh no encontrado, usando validadores individuales"
  ERRORS=0

  if echo "$MODIFIED" | grep -q 'admin.html' || [ "${NORMALIS_FULL_CHECK:-0}" = "1" ]; then
    if [ -f "$REPO_ROOT/validate-admin.sh" ]; then
      bash "$REPO_ROOT/validate-admin.sh" "$REPO_ROOT/admin.html" || ERRORS=$((ERRORS+1))
    fi
  fi

  if echo "$MODIFIED" | grep -q 'login.html' || [ "${NORMALIS_FULL_CHECK:-0}" = "1" ]; then
    if [ -f "$REPO_ROOT/validate-login.sh" ]; then
      bash "$REPO_ROOT/validate-login.sh" "$REPO_ROOT/login.html" || ERRORS=$((ERRORS+1))
    fi
  fi

  if [ "$ERRORS" -eq 0 ]; then
    echo "  COMMIT AUTORIZADO"; exit 0
  else
    echo "  COMMIT BLOQUEADO — $ERRORS errores criticos"; exit 1
  fi
fi
